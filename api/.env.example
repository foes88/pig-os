DATABASE_URL=postgresql+asyncpg://pigos:pigos@localhost:5432/pigos
REDIS_URL=redis://localhost:6379/0

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-at-least-32-chars

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

ENVIRONMENT=development
# ENVIRONMENT=production

# Production CORS (자동 적용됨)
# CORS_ORIGINS=["https://pigos.io","https://app.pigos.io"]

# Optional — Addon #1 AI Insight (LLM renderer). Absent → template renderer.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional — error monitoring
SENTRY_DSN=

# Optional — FCM 푸시 (G1). 둘 다 채워야 푸시 전송, 아니면 graceful skip.
# 활성화: `uv add google-auth` + 아래 2개 설정 (서비스 계정 JSON 경로).
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
