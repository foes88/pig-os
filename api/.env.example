DATABASE_URL=postgresql+asyncpg://pigos:pigos@localhost:5432/pigos
REDIS_URL=redis://localhost:6379/0

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-at-least-32-chars

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# PigPlan pilot-only account seed/UAT password. Set locally; do not commit real values.
PIGPLAN_PILOT_PASSWORD=
# Optional: use a running API instead of in-process ASGI for Phase B UAT.
PIGPLAN_PILOT_API_BASE=

ENVIRONMENT=development
# ENVIRONMENT=production

# Production CORS (자동 적용됨)
# CORS_ORIGINS=["https://pigos.io","https://app.pigos.io"]

# Optional — Addon #1 AI Insight (LLM renderer). Absent → template renderer.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional — error monitoring
SENTRY_DSN=

# Optional — FCM 푸시 (G1). 둘 다 채워야 푸시 전송, 아니면 graceful skip.
# 활성화: `uv add google-auth` + 아래 2개 설정 (서비스 계정 JSON 경로).
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# 이메일 발송 — AWS SES 우선(권장, 서울리전). SES_FROM_EMAIL(SES 인증 발신주소) 설정 시 SES 사용.
# AWS 자격증명은 표준 체인: AWS_ACCESS_KEY_ID/SECRET(env) 또는 EC2/ECS IAM 롤(권장, 키 불필요).
AWS_REGION=ap-northeast-2
SES_FROM_EMAIL=
# (IAM 롤 미사용 시) 정적 키 — 배포 시크릿으로만 주입, 여기 커밋 금지.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Fallback — SMTP 이메일 발송(SES 미설정 시). HOST+USER+PASSWORD 다 채워야 실제 발송,
# 아니면 graceful skip(로그 폴백). 실제 자격증명은 여기 커밋 금지 — 배포 시크릿으로 주입.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# 이메일 링크용 프론트 베이스 URL (운영: https://app.pigos.io)
APP_BASE_URL=http://localhost:3000
