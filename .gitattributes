# 모든 텍스트 파일은 저장소에서 LF로 정규화 (CRLF churn 방지)
* text=auto eol=lf

# Windows 전용 스크립트는 CRLF 유지 (현재 없지만 방어적)
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 바이너리 — 변환 금지
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.svg   text eol=lf
*.pdf   binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
