# PigOS 프로덕션 환경변수 — docker-compose.prod.yml(레포 루트)이 읽음.
# 실서버에서 `cp .env.example .env` 후 값 채우고 `chmod 600 .env`. 절대 커밋 금지.

# 필수
DATABASE_URL=postgresql+asyncpg://USER:PASS@RDS_HOST:5432/pigos
REDIS_URL=redis://redis:6379
SECRET_KEY=                 # openssl rand -hex 32

# 선택 — 미설정 시 graceful fallback
ANTHROPIC_API_KEY=         # AI Insight(자연어 설명). 없으면 템플릿 렌더러로 폴백
SENTRY_DSN=               # 에러 모니터링
FCM_PROJECT_ID=           # 모바일 푸시(FCM)
FCM_CREDENTIALS_PATH=     # FCM 서비스계정 키 경로(컨테이너 내)

# 참고: web(Next.js)의 NEXT_PUBLIC_API_URL / NEXT_PUBLIC_APP_URL 은
#       docker-compose.prod.yml의 build.args 에 고정(https://api.pigos.io / https://app.pigos.io).
#       도메인이 다르면 거기서 수정 후 web 이미지 재빌드 필요.
